# Copy this file to .env and fill it in. Never share or commit the .env file.

# Required. A long random text. Create one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. If empty, the database is instance/credit_union.db (the same file the old app used).
# For production MySQL, use: mysql://username:password@hostname/database_name
# Example: mysql://ucu_user:secure_password@localhost/ucu_production
DATABASE_URL=

# E-mail (receipts, verification messages). IMPORTANT: Configure these for production!
# Current setup uses mail.raydexhub.com on port 465 with SSL
MAIL_SERVER=mail.raydexhub.com
MAIL_PORT=465
MAIL_USE_SSL=1
MAIL_USE_TLS=0
MAIL_USERNAME=your_email@raydexhub.com
MAIL_PASSWORD=your_email_password

# Where messages from the Contact form and new sign-ups are sent.
ADMIN_EMAIL=agyareemmanuelosei@gmail.com

# Shown in the footer and used in e-mail links.
CONTACT_EMAIL=agyareemmanuelosei@gmail.com
CONTACT_PHONE=+233247767438
WHATSAPP_URL=https://wa.me/233247767438
FACEBOOK_URL=
TIKTOK_URL=
SITE_URL=https://ucu.raydexhub.com

# Set to 1 once the site runs on HTTPS.
FORCE_HTTPS=0
